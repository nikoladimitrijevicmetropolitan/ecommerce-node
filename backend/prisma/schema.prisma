generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  imageUrl    String
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
